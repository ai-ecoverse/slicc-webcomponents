{
  "name": "@ai-ecoverse/slicc-webcomponents",
  "version": "0.0.0",
  "description": "Shared SLICC web components on Spectrum Web Components",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-webcomponents.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-webcomponents",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "test": "node --test \"test/integration/**/*.test.mjs\"",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "2.13.7",
    "@biomejs/biome": "2.6.3",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  }
}
